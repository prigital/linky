# Google OAuth credentials (console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# HS256 signing key for the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change_me_to_a_random_string

# Public origin. In dev this is the Vite dev server so the OAuth callback lands
# back on the app. Register "<APP_URL>/auth/google/callback" in the Google
# console as an Authorized redirect URI.
APP_URL=http://localhost:5173

# Local DynamoDB (npm run ddb && npm run ddb:init)
LINKY_TABLE_NAME=linky-local
LINKY_DDB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=fakeMyKeyId
AWS_SECRET_ACCESS_KEY=fakeSecretAccessKey

PORT=3001

# In AWS these are set by CDK instead of the two above:
#   LINKY_SECRET_ID  name of the Secrets Manager secret holding
#                    GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / JWT_SECRET
#   LINKY_TABLE_NAME the deployed table name
